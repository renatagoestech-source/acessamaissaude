# Supabase PostgreSQL, somente no servidor PHP/Vercel (nunca no frontend)
# Para Vercel/serverless, copie Supabase Dashboard > Connect > Transaction pooler (Shared, IPv4, porta 6543).
# Use host e usuário exatos fornecidos pelo painel; codifique caracteres reservados da senha como percent-encoding.
DATABASE_URL="postgresql://postgres.<project-ref>:<senha>@<host-pooler>:6543/postgres?sslmode=require"

# Banco MySQL/TiDB legado para desenvolvimento ou instalação anterior
ACESSA_DB_HOST=seu-host-mysql
ACESSA_DB_PORT=3306
ACESSA_DB_NAME=conecta_saude
ACESSA_DB_USER=seu_usuario
ACESSA_DB_PASS=sua_senha
# Opcional: caminho do pacote CA se seu provedor exigir TLS e você configurar ACESSA_DB_* manualmente.
# ACESSA_DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt
# A integração Vercel do TiDB Cloud define TIDB_HOST, TIDB_PORT, TIDB_USER, TIDB_PASSWORD e TIDB_DATABASE.
# O app usa essas variáveis automaticamente quando DATABASE_URL e ACESSA_DB_HOST não estão definidos; TiDB usa TLS.
# Modo demonstração: não configure ASAAS_API_KEY agora.
# Quando liberar cobranças reais:
# ASAAS_ENV=sandbox
# ASAAS_API_KEY=sua_chave_api
# ASAAS_WEBHOOK_TOKEN=seu_token_webhook

# E-mail transacional (recuperação de senha e confirmações; não bloqueia cadastro/login)
RESEND_API_KEY=
MAIL_FROM="Acessa+ Saúde <agenda@seudominio.com>"
APP_URL=https://seudominio.com
