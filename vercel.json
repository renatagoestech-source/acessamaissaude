{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 60
    },
    "api/api.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/ubs/?$",
      "dest": "/api/index.php?portal=ubs"
    },
    {
      "src": "/clinica/?$",
      "dest": "/api/index.php?portal=clinica"
    },
    {
      "src": "/api.php",
      "dest": "/api/api.php"
    },
    {
      "src": "/(.*\\.(?:css|js|png|jpg|jpeg|webp|svg|ico))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
